{
  "name": "inertia-devtools",
  "version": "0.2.0",
  "description": "Developer tools for Inertia.js — see what happens behind every click",
  "author": "Svyatoslav Kryukov <me@skryukov.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skryukov/inertia-devtools.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/auto.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json --noEmit false --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:css": "node scripts/check-css-tokens.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "inertia",
    "inertiajs",
    "devtools",
    "developer-tools",
    "debugging",
    "svelte"
  ],
  "peerDependencies": {
    "@inertiajs/core": ">=3.4.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@inertiajs/core": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inertiajs/core": "^3.4.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.0.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^28.1.0",
    "oxlint": "^1.50.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
